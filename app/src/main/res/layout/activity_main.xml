<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView bech el formulaire yet9ra kamel 7atta fel écran sghir -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/creme"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- kol element yji ta7t elli 9ablou -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- el titre -->
        <TextView
            android:id="@+id/tv_titre_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/titre_formulaire"
            android:textColor="@color/bleu_passeport"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- esm el voyageur -->
        <EditText
            android:id="@+id/et_nom_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName" />

        <!-- 3am el wleda: ar9am bark, 4 maximum -->
        <EditText
            android:id="@+id/et_naissance_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_naissance"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <!-- 3am el destination: ar9am bark, 4 maximum -->
        <EditText
            android:id="@+id/et_destination_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_destination"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4" />

        <!-- ktiba "Motif du voyage" -->
        <TextView
            android:id="@+id/tv_label_motif_ea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_motif"
            android:textColor="@color/bleu_passeport"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- RadioGroup: na5tarou motif wa7ed bark -->
        <RadioGroup
            android:id="@+id/rg_motif_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_tourisme_ea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motif_tourisme" />

            <RadioButton
                android:id="@+id/rb_modification_ea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motif_modification" />

            <RadioButton
                android:id="@+id/rb_fuite_ea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/motif_fuite" />
        </RadioGroup>

        <!-- el bouton elli y7el el écran 2 -->
        <Button
            android:id="@+id/btn_inspecter_ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/btn_inspecter"
            android:textColor="@color/blanc"
            app:backgroundTint="@color/bleu_passeport" />

    </LinearLayout>
</ScrollView>